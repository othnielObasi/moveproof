# Frontend environment variables
# Copy to .env.local for local development.

# Backend API base. Defaults to /api (same origin, behind a reverse proxy).
# Local development without a proxy:
NEXT_PUBLIC_API_BASE=http://localhost:8080

# WebSocket base for live run feeds. Optional: when unset, the frontend uses
# the API base, or the backend on :8080 locally, or the same origin.
# NEXT_PUBLIC_WS_BASE=ws://localhost:8080
